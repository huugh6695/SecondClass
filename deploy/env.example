# =============================================================
# /etc/second-classroom/env —— 应用的环境变量（模板）
#
# 安装（详见 DEPLOY.md §9）：
#   sudo mkdir -p /etc/second-classroom
#   sudo cp env.example /etc/second-classroom/env
#   sudo nano /etc/second-classroom/env          # 把下面 3 个"必填"换成真实值
#   sudo chown root:root /etc/second-classroom/env
#   sudo chmod 600 /etc/second-classroom/env      # 🔴 里面有密码，别让别的账号看到
#
# 语法规矩（systemd 的 EnvironmentFile 不是 shell）：
#   · 一行一个 KEY=VALUE
#   · 等号两边**不要空格**，值**不要加引号**，不要写 export
#   · 值里不要有 $（systemd 会尝试展开）—— 所以 JWT_SECRET 用 base64 而不是手写的复杂符号
# =============================================================

# ========== 必填三件套（application-prod.yml 里没有默认值，缺一个就起不来）==========

# 数据库密码。这条如果不改，就是 web 服务器沦陷后第一件被拿走的东西。
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT 签名密钥。
# 🔴 绝对不能用 application.yml 里那个开发值 —— 它已经进过代码仓库，等于公开，
#    拿它签生产 Token，任何人都能自己伪造一个管理员 Token 进来。
# 生成方法（在服务器上执行，复制输出粘贴到这里）：
#     openssl rand -base64 64
# 长度要求：至少 32 字节。64 字节时算法是 HS512（我们开发环境就是 64 字节）。
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_64

# ========== 学生自助注册 / 短信验证 ==========
# 生产默认要求 webhook；它应由你的短信服务商适配器接收，再把验证码发送给运营商。
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=https://sms-gateway.example.edu/send
SMS_WEBHOOK_TOKEN=CHANGE_ME_SMS_GATEWAY_TOKEN
# 建议独立于 JWT_SECRET；不填时暂回退到 JWT_SECRET。
SMS_PHONE_ENCRYPTION_KEY=CHANGE_ME_OPENSSL_RAND_BASE64_64
SMS_PHONE_HASH_SECRET=CHANGE_ME_ANOTHER_RANDOM_SECRET
SMS_EXPOSE_DEV_CODE=false

# 附件落盘目录。🔴 必须是**绝对路径**：systemd 跑的时候工作目录不是项目目录，
#    写相对路径 ./uploads 会落到 / 或 /var/lib 之类意想不到的地方，甚至直接没权限。
UPLOAD_DIR=/srv/second-classroom/uploads

# ========== 下面这些都有默认值，一般不用动 ==========

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=second_classroom
DB_USERNAME=sc_app
DB_POOL_SIZE=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 只有给 Redis 设了 requirepass 才需要填。Redis 只监听 127.0.0.1 且防火墙封了 6379 时，
# 留空即可（已验证：留空 = 不鉴权，能正常连上）。
REDIS_PASSWORD=

SERVER_PORT=8080
LOG_DIR=/var/log/second-classroom
